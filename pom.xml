<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.mcmiddleearth</groupId>
    <artifactId>thegaffer-parent</artifactId>
    <version>2.8</version>
    <packaging>pom</packaging>

    <name>TheGaffer (parent)</name>
    <url>http://www.mcmiddleearth.com/</url>

    <!--
      Three modules, because the proxy and the backend must agree on a wire format:

        thegaffer-core      the plugin-message protocol both sides speak, and nothing else
        thegaffer-paper     the Paper plugin (artifactId stays TheGaffer, so the deployed
                            jar name is unchanged)
        thegaffer-velocity  the Velocity proxy plugin: keeps a registry of which job is on
                            which server and moves players to it

      The protocol lives in its own module on purpose. Duplicating those classes into both
      sides is how a wire format silently drifts apart.
    -->
    <modules>
        <module>thegaffer-core</module>
        <module>thegaffer-paper</module>
        <module>thegaffer-velocity</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>Scarsz-Nexus</id>
            <url>https://nexus.scarsz.me/content/groups/public/</url>
        </repository>
        <repository>
            <id>mikeprimm</id>
            <url>https://repo.mikeprimm.com/</url>
        </repository>
    </repositories>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.9.0</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
